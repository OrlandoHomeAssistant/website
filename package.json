{
  "name": "home-assistant-orlando-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "test": "node --test tests/*.test.js",
    "typecheck": "wrangler types && tsc --noEmit",
