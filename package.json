{
  "name": "home-assistant-orlando-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "test": "npm run test:unit && npm run test:integration",
    "typecheck": "wrangler types && tsc --noEmit",
    "deploy:dev": "wrangler deploy --name orlando-home-assistant-dev",
    "check": "npm test && npm run typecheck && wrangler deploy --dry-run",
    "assets": "node scripts/generate-assets.mjs",
    "test:unit": "node --test tests/*.test.js",
    "test:integration": "node --test --test-concurrency=1 tests/integration/*.test.js",
    "smoke": "node scripts/smoke.mjs",
    "deploy:production": "wrangler deploy --config wrangler.production.jsonc"
  },
  "dependencies": {
    "ical.js": "^2.2.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "miniflare": "5.20261116.0-beta",
    "typescript": "^7.0.2",
    "wrangler": "^4.163.0"
  },
  "engines": {
    "node": ">=24"
  }
}
