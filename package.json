  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.6.6",
    "typescript": "^5.9.3",
    "wrangler": "^4.163.0"
  }
}
